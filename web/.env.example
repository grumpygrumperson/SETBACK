# Frontend environment. Both values are PUBLIC by design - they are compiled
# into the browser bundle, which is why they carry the NEXT_PUBLIC_ prefix.
#
# NEVER put SUPABASE_KEY (service_role) or FERNET_KEY in this file or in any
# Vercel variable for this project. Those decrypt every participant's exchange
# credentials; they belong only to the Railway backend service.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# The ANON key. RLS is what constrains it - see the policies at the bottom of
# ../migrations/schema.sql.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
