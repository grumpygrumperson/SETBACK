# Copy to .env and fill in. `.env` is gitignored; this file is not, so it must
# never contain a real value.
#
# Locally, load_dotenv() reads .env into the environment. On Railway there is
# no .env file at all - Railway injects these into the process before Python
# starts, and load_dotenv() finds nothing and does nothing. Set them in the
# service's Variables tab, using the same names.


# ---------------------------------------------------------------------------
# Required - the service will not start without these
# ---------------------------------------------------------------------------

# Supabase project URL and API key. The sync needs write access, so this is
# the service_role key, not the anon key. Row Level Security is enabled on
# every table (see migrations/schema.sql section 10) precisely because the
# anon key must be able to reach nothing.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=

# The Fernet key that encrypts participants' stored exchange credentials.
#
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# CHANGING THIS WITHOUT ROTATING ORPHANS EVERY STORED CREDENTIAL. Nothing
# decrypts, every participant has to issue new exchange keys, and there is no
# way back. See "Rotating FERNET_KEY" in README.md before touching it.
FERNET_KEY=


# ---------------------------------------------------------------------------
# Competition window
# ---------------------------------------------------------------------------

# Bounds SCORING, not fetching. Fetching is bounded below by COMPETITION_START
# so the sync does not re-walk years of history, and is deliberately unbounded
# above - the cron keeps recording after the close, which is what you want for
# an audit trail and for spotting a key that dies late.
#
# COMPETITION_END must be the last instant that counts, so use end-of-day.
# Setting 2026-10-27T00:00:00Z discards the whole of the final day.
COMPETITION_START=2026-09-01T00:00:00Z
COMPETITION_END=2026-10-26T23:59:59Z


# ---------------------------------------------------------------------------
# Optional - sensible defaults, override only with a reason
# ---------------------------------------------------------------------------

# INFO shows the operational lines. DEBUG adds per-symbol pricing detail.
LOG_LEVEL=INFO

# How many credentials to sync concurrently. Almost all of a run is spent
# waiting on exchange HTTP. Set to 1 for a strictly serial run.
SYNC_WORKERS=8

# Per-venue request rates for the whole run, as venue=requests_per_second:
#
#   SHARED_RATE_LIMIT=lighter=4,coinbase=25
#
# Unset means each venue is paced at ccxt's own rateLimit for it - 29.4 req/s
# for Coinbase, 1 req/s for Lighter - so the entire sync behaves as one
# well-behaved ccxt client regardless of SYNC_WORKERS.
#
# That default is deliberately conservative, and on a venue that meters per
# API KEY rather than per IP it costs throughput for nothing: every
# participant brings their own key, so their budgets are genuinely
# independent. Coinbase's private endpoints are per-key and can be raised
# here. Lighter's are unconfirmed, which is why the default is what it is.
SHARED_RATE_LIMIT=

# Fraction of credentials that must fail before the run exits non-zero.
# Default 1.0 - only a total failure fails the run, because one participant's
# revoked key is not an outage. See exit_code_for() for the reasoning.
SYNC_FAILURE_THRESHOLD=1.0

# Older Fernet keys, comma-separated, decrypt-only. Used during a rotation so
# existing rows keep opening while they are re-encrypted. Remove once
# `python rotate_credentials.py` reports every row on the current key.
FERNET_KEYS_RETIRED=


# ---------------------------------------------------------------------------
# Dangerous - leave unset on the deployed service
# ---------------------------------------------------------------------------

# Allows a Lighter L1 WALLET PRIVATE KEY to be used instead of a read-only
# token. A wallet key is unscoped and irrevocable: it controls every asset in
# that wallet on every chain, and a competition backend must never hold one.
#
# Exists only so the operator can test against their own account locally.
# NEVER set this on Railway.
# ALLOW_WALLET_KEYS=1

# Treats a failure to READ a Coinbase key's permissions as a pass. A legacy
# HMAC key can 401 where a CDP key succeeds, so this is the escape hatch - but
# with it set, an error registers a credential whose permissions are unknown,
# which may include trade or transfer rights.
# COINBASE_PERMISSIONS_OPTIONAL=1

# Rejects a Lighter token whose scope is not in LIGHTER_ALLOWED_SCOPES.
# Lighter's scope vocabulary is not yet confirmed, so this is off by default
# and the `ro:` prefix is the load-bearing control. Turn it on once real scope
# values have been observed in the logs.
# LIGHTER_ENFORCE_SCOPE=1
# LIGHTER_ALLOWED_SCOPES=all


# ---------------------------------------------------------------------------
# Operator's own exchange credentials - local testing only
#
# Participants' keys NEVER come from here. They are decrypted out of Supabase
# by build_from_credential(). These drive `python coinbase.py` and
# `python lighter.py`, which sanity-check an adapter against a real account.
# None of them belong on Railway.
# ---------------------------------------------------------------------------

# Coinbase issues separate credentials for spot and perps.
COINBASE_APIKEY=
COINBASE_SECRET=
COINBASEPERP_APIKEY=
COINBASEPERP_SECRET=

# Optional. Skips the portfolio lookup for Coinbase INTX perps.
COINBASEPERP_PORTFOLIO=

# Lighter read-only token: ro:<account_index>:<scope>:<deadline>:<signature>
LIGHTER_READONLY_TOKEN=

# Lighter L1 wallet private key. Only usable with ALLOW_WALLET_KEYS set, and
# only for your own account. Read the warning above first.
LIGHTER_PRIVATEKEY=
LIGHTER_ACCOUNT_INDEX=
LIGHTER_APIKEY_INDEX=
